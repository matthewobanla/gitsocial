# Buffer API Credentials (from https://publish.buffer.com/settings/api?tab=app-clients)
BUFFER_CLIENT_ID=your_buffer_client_id_here
BUFFER_CLIENT_SECRET=your_buffer_client_secret_here
BUFFER_REDIRECT_URI=https://localhost:3000/api/auth/buffer/callback

# Optional: Default token for zero-touch webhook automation without per-request auth header
BUFFER_DEFAULT_TOKEN=

# Optional: GitHub token for higher rate limits on GitHub release fetching
GITHUB_TOKEN=
